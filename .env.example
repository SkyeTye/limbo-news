ANTHROPIC_API_KEY=sk-ant-...
# Flask settings (optional)
FLASK_PORT=5000
FLASK_DEBUG=false

# Video fact-checker (/check)
FACTCHECK_PASSWORD=pick-a-long-password
# SCRAPECREATORS_API_KEY=   # post lookup for TikTok/Instagram/YouTube/X (same key as Content Files)
# GROQ_API_KEY=             # transcripts when the platform gives none (same key as Content Files)
# GOOGLE_FACTCHECK_API_KEY= # optional: finds existing fact-checks faster (their verdicts stay hidden from the tracer)
# DATA_DIR=/app/userdata    # Railway volume, so the source library survives deploys
# Limits: FACTCHECK_DAILY_LIMIT=15  FACTCHECK_MONTHLY_BUDGET_USD=15  FACTCHECK_MONTHLY_LOOKUP_LIMIT=300
